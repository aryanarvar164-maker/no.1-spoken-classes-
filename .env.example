# ---- Enquiry notifications (email via Resend) ----
# Create an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=

# The verified "from" address, e.g. "No. 01 Website <enquiries@yourdomain.com>"
ENQUIRY_FROM_EMAIL=

# Where enquiries are delivered (the owner's inbox). Comma-separate for several.
ENQUIRY_TO_EMAIL=

# ---- Cloudinary ----
# Public — the only Cloudinary value the website itself needs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# PRIVATE — server only. Used by the owner editor (saving content, signing uploads)
# and by `npm run upload-media`. Add them to Vercel too, but NEVER with a NEXT_PUBLIC_ prefix.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Owner editor ----
# The private editing link is  https://yoursite.com/owner/<OWNER_SECRET>
# Make a long random value (at least 24 characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Leave empty to switch the editor off. Change it to revoke the old link.
OWNER_SECRET=

# Public site URL, used for metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com
